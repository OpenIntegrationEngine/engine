# Line-ending rules for files where endings are functional.
# (Pattern follows PR #214 by NicoPiel.)

# Unix start scripts must stay LF
/gradlew        text eol=lf
oieserver       text eol=lf
configure-from-env text eol=lf

# Windows scripts must stay CRLF
*.bat           text eol=crlf

# Stored with LF, checked out with native endings. install4j rewrites
# the whole file with the platform's endings on save.
*.install4j     text

# Binary files are left untouched
*.jar           binary

# NCPDP fixtures delimit with control characters (0x1C/0x1D/0x1E), not line breaks
/server/tests/test-ncpdp-*-input.txt binary
