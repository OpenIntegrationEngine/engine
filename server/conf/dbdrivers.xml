<!-- 
	Database driver information
	class = the driver class name, cannot be empty
	name = database driver name to be displayed as, cannot be empty
	template = the template for creating the database connection, cannot be empty
	alternativeClasses = A comma-separated list of legacy driver classes (optional).
-->
<drivers>
	<driver class="com.mysql.cj.jdbc.Driver" name="MySQL" template="jdbc:mysql://host:port/dbname" alternativeClasses="com.mysql.jdbc.Driver" />
	<driver class="oracle.jdbc.driver.OracleDriver" name="Oracle" template="jdbc:oracle:thin:@host:port:dbname" />
	<driver class="org.postgresql.Driver" name="PostgreSQL" template="jdbc:postgresql://host:port/dbname" />
	<driver class="net.sourceforge.jtds.jdbc.Driver" name="SQL Server/Sybase (jTDS)" template="jdbc:jtds:sqlserver://host:port/dbname" />
	<driver class="com.microsoft.sqlserver.jdbc.SQLServerDriver" name="Microsoft SQL Server" template="jdbc:sqlserver://host:port;databaseName=dbname" />
	<driver class="org.sqlite.JDBC" name="SQLite" template="jdbc:sqlite:dbfile.db" />
</drivers>