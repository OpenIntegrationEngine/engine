        <script>// The message the test marks as stuck never sends; it stays on the queue as the head that a
// rotating queue has to step over. Every other message sends as soon as this run's token opens
// the gate. Returning QUEUED is a send failure the queue retries, not an error.
var configuration = com.mirth.connect.server.controllers.ConfigurationController.getInstance();
var payload = String(connectorMessage.getEncodedData());
var token = payload.split('#')[0];
if (payload.indexOf('#stuck') &gt; 0
        || String(configuration.getConfigurationMap().get('oie.smoketest.releaseDestinationQueueRotate')) != token) {
    return com.mirth.connect.userutil.Status.QUEUED;
}

// The order in which the destination queue drained this message, which is what the test asserts.
var order = globalChannelMap.containsKey('order') ? globalChannelMap.get('order') : 0;
order = order + 1;
globalChannelMap.put('order', order);
return 'order=' + order;</script>
